# ==========================================================================
# celest.ia engine — configuração
# Copie para `.env` na raiz do repositório e preencha o que tiver.
# Tudo é opcional: sem chaves, o pré-filtro é pulado e o scraping roda direto;
# com CELESTIA_MOCK=1 tudo funciona offline com dados determinísticos.
# ==========================================================================

# --- Pré-filtro de preços (reduz o custo por pesquisa) --------------------
# Google Flights via SerpApi — crie a conta em https://serpapi.com
# (plano free: 100 buscas/mês; pago a partir de ~US$75/mês)
SERPAPI_KEY=

# Skyscanner Partners API v3 — https://developers.skyscanner.net
# (requer aprovação como parceiro; use preços "indicative" como pré-filtro)
SKYSCANNER_API_KEY=

# Alternativa comunitária ao Skyscanner via RapidAPI (hub "sky-scrapper") —
# https://rapidapi.com — preencha se não tiver a chave oficial acima.
RAPIDAPI_KEY=

# --- Scraping das companhias (Playwright/Chromium, sem chave) -------------
# Os templates de URL dos sites podem mudar; ajuste aqui sem tocar em código.
# Placeholders disponíveis: {origin} {destination} {date} {adults} {cabin}
#COPA_BOOKING_URL=https://shopping.copaair.com/flights/{origin}-{destination}?date={date}&adults={adults}&cabin={cabin}
#LATAM_OFFERS_URL=https://www.latamairlines.com/br/pt/oferta-voos?origin={origin}&destination={destination}&outbound={date}&adt={adults}&cabin={cabin}
#SCRAPER_HEADLESS=1
#SCRAPER_TIMEOUT_MS=45000

# --- Milheiro (R$ por 1.000 milhas) — calibre com o preço que VOCÊ paga ---
#MILHEIRO_CONNECTMILES=34.0
#MILHEIRO_LATAMPASS=29.0
#MILHEIRO_SMILES=22.0
#MILHEIRO_AZUL=24.0

# --- Orquestrador ---------------------------------------------------------
# Quantos candidatos sobrevivem ao pré-filtro e vão para o scraping caro:
#PREFILTER_TOP_K=4
# Subagentes simultâneos (sessões de browser/chamadas paralelas):
#MAX_SUBAGENTS=6
#HTTP_TIMEOUT_S=20

# --- Demo offline ---------------------------------------------------------
#CELESTIA_MOCK=1
