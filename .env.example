# ==========================================================================
# celest.ia engine — configuração
# Copie para `.env` na raiz do repositório e preencha o que tiver.
# Tudo é opcional: sem chaves, o pré-filtro é pulado e o scraping roda direto;
# com CELESTIA_MOCK=1 tudo funciona offline com dados determinísticos.
# ==========================================================================

# --- Pré-filtro de preços (reduz o custo por pesquisa) --------------------
# Google Flights via SerpApi — crie a conta em https://serpapi.com
# (plano free: 100 buscas/mês; pago a partir de ~US$75/mês)
SERPAPI_KEY=

# Skyscanner Partners API v3 — https://developers.skyscanner.net
# (requer aprovação como parceiro; use preços "indicative" como pré-filtro)
SKYSCANNER_API_KEY=

# Chave única do RapidAPI (https://rapidapi.com) — vale para TODAS as APIs do
# hub que você assinar: google-flights2 (pré-filtro Google Flights barato),
# sky-scrapper/flights-sky (Skyscanner) e Lyov (malha RPL/DECEA).
RAPIDAPI_KEY=

# Wrapper Skyscanner a usar (troque sem tocar em código):
#RAPIDAPI_SKY_HOST=sky-scrapper.p.rapidapi.com
#RAPIDAPI_SKY_HOST=flights-sky.p.rapidapi.com
#RAPIDAPI_SKY_ENDPOINT=/api/v1/flights/searchFlights

# Desligue fontes RapidAPI individuais (ex.: assinou só o google-flights2):
#GF2_ENABLED=1
#RAPIDAPI_SKY_ENABLED=1

# Hosts das demais APIs RapidAPI (padrões já corretos):
#GF2_HOST=google-flights2.p.rapidapi.com
#GF2_ENDPOINT=/api/v1/searchFlights
#LYOV_HOST=brazilian-airlines-real-flights-data.p.rapidapi.com
#LYOV_PATH=/api/flights

# --- Scraping gerenciado (Firecrawl) --------------------------------------
# https://firecrawl.dev — proxies, anti-bot e extração estruturada como
# serviço. Com a chave configurada, Copa/LATAM são raspadas via Firecrawl e
# o Playwright local vira fallback automático. (free ~500 créditos;
# planos a partir de ~US$16/mês; ~2 créditos por página raspada)
FIRECRAWL_API_KEY=
#FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape

# Modo Interact (sessão de browser viva, v2) — preenche o formulário e extrai
# tarifas de várias companhias de uma vez. É a estratégia preferida quando
# funciona. Ver docs/scraping-protocol.md.
#FIRECRAWL_INTERACT=1
#FIRECRAWL_API_BASE=https://api.firecrawl.dev
#COPA_INTERACT_URL=https://www.copaair.com/pt-br/
#LATAM_INTERACT_URL=https://www.latamairlines.com/br/pt
# Calendário de preços (flexibilidade de datas): o flex-date scout lê os preços
# por data no Google Flights e corta as datas caras antes de raspar.
#GOOGLE_FLIGHTS_INTERACT_URL=https://www.google.com/travel/flights?hl=pt-BR&curr=BRL
#USD_BRL_RATE=5.40
# Estratégias de scraping e ordem-base (o desempenho real reordena a cada busca):
#SCRAPE_STRATEGIES=firecrawl_interact,firecrawl_scrape,playwright_local
#STRATEGY_CSV=data/strategy_performance.csv

# --- Scraping das companhias (Playwright/Chromium, sem chave) -------------
# Os templates de URL dos sites podem mudar; ajuste aqui sem tocar em código.
# Placeholders disponíveis: {origin} {destination} {date} {adults} {cabin}
#COPA_BOOKING_URL=https://shopping.copaair.com/?roundtrip=false&adults={adults}&children=0&infants=0&sf=br&langid=pt&date1={date}&promocode=&area1={origin}&area2={destination}&advanced_air_search=false&flexible_dates_v2=false
#LATAM_OFFERS_URL=https://www.latamairlines.com/br/pt/ofertas-voos?origin={origin}&outbound={date}T00%3A00%3A00.000Z&destination={destination}&inbound=null&adt={adults}&chd=0&inf=0&trip=OW&cabin={cabin}&redemption=false&sort=RECOMMENDED
#SCRAPER_HEADLESS=1
#SCRAPER_TIMEOUT_MS=45000

# --- Milheiro (R$ por 1.000 milhas) — calibre com o preço que VOCÊ paga ---
#MILHEIRO_CONNECTMILES=34.0
#MILHEIRO_LATAMPASS=29.0
#MILHEIRO_SMILES=22.0
#MILHEIRO_AZUL=24.0

# --- Orquestrador ---------------------------------------------------------
# Quantos candidatos sobrevivem ao pré-filtro e vão para o scraping caro:
#PREFILTER_TOP_K=4
# Subagentes simultâneos (sessões de browser/chamadas paralelas):
#MAX_SUBAGENTS=6
#HTTP_TIMEOUT_S=20

# --- Dados / Machine Learning ---------------------------------------------
# Toda busca alimenta <HISTORY_DIR>/searches.csv (esquema fixo, append-only)
# — é o dataset de treino do ML do celest.ia.
#HISTORY_ENABLED=1
#HISTORY_DIR=data
# Malha viva gerada por `python -m celestia_engine mesh` (Lyov/DECEA):
#MESH_CSV=data/routes_live.csv

# --- Demo offline ---------------------------------------------------------
#CELESTIA_MOCK=1
