# Investment Intelligence OS — variáveis de ambiente (nenhum secret é obrigatório no MVP)
# Nome do produto (nunca acoplado ao código)
IIOS_SYSTEM_NAME=Investment Intelligence OS
IIOS_BASE_CURRENCY=BRL

# Parâmetros iniciais EDITÁVEIS do investidor (docs/ASSUMPTIONS.md)
IIOS_MONTHLY_CONTRIBUTION=100000
IIOS_REFERENCE_RATE_PCT=7.11

# Diretório de dados (bronze/silver/gold/documents/audit/reports)
# IIOS_DATA_DIR=./data

# Cache local opcional de arquivos já baixados das mesmas URLs oficiais
# IIOS_CACHE_DIR=

# Identificação nas requisições às fontes oficiais
# IIOS_USER_AGENT=InvestmentIntelligenceOS/0.1 (pesquisa pessoal)

# Origens EXTRAS liberadas no CORS da API (painel hospedado), separadas por
# vírgula. localhost:3000 já é liberado por padrão para dev. Ex.:
# IIOS_CORS_ORIGINS=https://meu-painel.vercel.app

# Chave da Anthropic para o chat "Pergunte à IA" (Fase 7). Sem ela, o /v1/chat
# responde 503 estruturado — nenhuma outra função depende disso.
# ANTHROPIC_API_KEY=

# Token brapi.dev — fonte SECUNDÁRIA (agregador) para cotação intradiária
# INDICATIVA, autorizada pelo usuário (ADR-0006). Nunca usada em cálculos.
# IIOS_BRAPI_TOKEN=

# NUNCA coloque aqui: senhas de B3/corretora/banco/gov.br (proibido pelo projeto)
