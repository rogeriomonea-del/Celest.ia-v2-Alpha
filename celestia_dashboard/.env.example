# Copie para .env.local (nunca commite valores reais).

# Somente servidor (funcoes /api). Use duffel_test_... em previews.
DUFFEL_ACCESS_TOKEN=

# Somente servidor: consultas de award (milhas) no seats.aero; chave Partner-Authorization.
# Vazio = busca segue sem awards ("Consulta de award nao configurada").
SEATS_AERO_API_KEY=

# Cliente (publicos): URL do projeto Supabase e a chave anon publica.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
