# celestia_engine — variáveis lidas em celestia_engine/config.py.
# Copie para engine/.env e descomente só o que precisar. Sem nada definido o
# motor não usa nenhuma API paga e não raspa sites (sem chaves = desligado).
# Nunca commite o .env com valores.

# --- Chaves de API (pré-filtro) ---
# SERPAPI_KEY=
# SKYSCANNER_API_KEY=
# RAPIDAPI_KEY=

# --- Firecrawl (scraping gerenciado) ---
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=
# FIRECRAWL_API_BASE=
# FIRECRAWL_INTERACT=
# COPA_INTERACT_URL=
# LATAM_INTERACT_URL=
# GOL_INTERACT_URL=
# AZUL_INTERACT_URL=
# GOOGLE_FLIGHTS_INTERACT_URL=

# --- RapidAPI (todas usam RAPIDAPI_KEY) ---
# RAPIDAPI_SKY_HOST=
# RAPIDAPI_SKY_ENDPOINT=
# RAPIDAPI_SKY_ENABLED=
# GF2_HOST=
# GF2_ENDPOINT=
# GF2_ENABLED=
# LYOV_HOST=
# LYOV_PATH=

# --- Scraping das companhias ---
# SCRAPE_STRATEGIES=
# COPA_BOOKING_URL=
# LATAM_OFFERS_URL=
# GOL_BOOKING_URL=
# AZUL_BOOKING_URL=
# SCRAPER_HEADLESS=
# SCRAPER_TIMEOUT_MS=
# SUBAGENT_TIMEOUT_S=
# USD_BRL_RATE=

# --- Orquestrador ---
# PREFILTER_TOP_K=
# MAX_SUBAGENTS=
# METASEARCH_TOP_N=
# HTTP_TIMEOUT_S=
# API_SEARCH_TIMEOUT_S=
# CELESTIA_MOCK=

# --- Dados locais (relativos a engine/) ---
# HISTORY_ENABLED=
# HISTORY_DIR=
# MESH_CSV=
# STRATEGY_CSV=

# --- Milheiro (R$ por 1.000 milhas; deve ser > 0) ---
# MILHEIRO_CONNECTMILES=
# MILHEIRO_LATAMPASS=
# MILHEIRO_SMILES=
# MILHEIRO_AZUL=
